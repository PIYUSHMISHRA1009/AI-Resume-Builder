PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Use either an Atlas URI or a local MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/resume-builder
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# The configured collection dimension must match the embeddings returned by this model.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# `mongodb` needs no Qdrant credentials. `shadow` and `qdrant` require both
# QDRANT_URL and QDRANT_API_KEY; otherwise startup falls back to `mongodb`.
VECTOR_STORE=mongodb
# Qdrant endpoint URL (placeholder only; never put credentials in the URL).
QDRANT_URL=https://your-cluster.cloud.qdrant.io
# Replace locally with a Qdrant API key. Never commit a real key.
QDRANT_API_KEY=replace-with-qdrant-api-key
# Defaults to resume_embeddings when unset.
QDRANT_COLLECTION=resume_embeddings

# Optional: Redis is disabled when REDIS_URL is empty or unset.
# Start local Redis with: docker run -p 6379:6379 redis:7
REDIS_URL=
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_CACHE_TTL_SECONDS=86400
